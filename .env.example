# --- Required ---------------------------------------------------------------
# HTTP endpoint of a BNB Smart Chain node. It must support eth_getLogs and
# eth_call state overrides (most providers' free tiers do: NodeReal, Ankr, QuickNode...).
RPC_URL=https://bsc-mainnet.example.com/your-key

# --- Telegram alerts (optional) ---------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# all | min_score | off
ALERT_MODE=min_score
ALERT_MIN_SCORE=60

# --- Scanner -----------------------------------------------------------------
DATABASE_URL=sqlite://rugradar.db
POLL_INTERVAL_SECS=6
START_LOOKBACK_BLOCKS=200
MAX_BLOCK_RANGE=500
# BNB used in the simulated buy (nothing is spent: it is an eth_call)
SIM_BUY_BNB=0.01
RUST_LOG=info

# --- Other Uniswap V2 forks / chains (defaults: PancakeSwap V2 on BSC) --------
# CHAIN_ID=56
# FACTORY_ADDRESS=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
# ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
# WRAPPED_NATIVE_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# Delay discovery to reduce exposure to short chain reorganizations.
CONFIRMATIONS=15
ALERT_MIN_LIQUIDITY_BNB=0
ALERT_MAX_TAX_BPS=10000
